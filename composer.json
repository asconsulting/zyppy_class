{
    "name":"asconsulting/zyppy_class",
    "description":"A module for the Contao CMS to allow for easy selection of pre-configured CSS classes.",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "class", "css", "selector", "styles", "style sheet", "stylesheet"],
    "type":"contao-bundle",
    "license":"LGPL-3.0-or-later",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": ">=8.1",
        "contao/core-bundle": "^5.3",
        "codefog/contao-haste": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ZyppyClass\\": "src/"
        }
    },
	"extra": {
		"contao-manager-plugin": "ZyppyClass\\ContaoManager\\Plugin"
	},
    "minimum-stability": "dev"
}
